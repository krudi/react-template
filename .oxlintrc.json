{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "typescript", "react", "unicorn", "import", "oxc", "promise", "jsx-a11y", "nextjs"],
    "options": {
        "typeAware": true,
        "reportUnusedDisableDirectives": "warn"
    },
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn"
    },
    "rules": {
        "react/rules-of-hooks": "error",
        "react/no-children-prop": "off",
        "react/react-in-jsx-scope": "off",
        "jsx-a11y/html-has-lang": "warn",
        "jsx-a11y/lang": "warn"
    },
    "ignorePatterns": [
        ".agents",
        ".ai",
        ".claude",
        ".codex",
        "node_modules",
        "dist",
        "build",
        "coverage",
        ".cache",
        ".turbo",
        "*.tsbuildinfo",
        ".next",
        "public",
        "next-env.d.ts"
    ]
}
