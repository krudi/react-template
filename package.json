{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "react-template",
    "version": "0.1.0",
    "private": false,
    "description": "A template with Next.js built on React with focus on performance and best practices.",
    "keywords": [
        "template"
    ],
    "homepage": "https://github.com/krudi/react-template#readme",
    "bugs": {
        "url": "https://github.com/krudi/react-template/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/krudi/react-template.git"
    },
    "license": "MIT",
    "author": {
        "name": "krudi",
        "email": "patryk.kudlik@gmail.com",
        "url": "https://krudi.io"
    },
    "type": "module",
    "scripts": {
        "build": "next build",
        "clean": "rm -rf .cache node_modules .next",
        "dev": "next dev",
        "dev:turbo": "next dev --turbo",
        "format:ox": "oxfmt .",
        "format:ox:check": "oxfmt --check .",
        "lint": "npm run lint:ox && npm run format:ox:check",
        "lint:ox": "oxlint .",
        "lint:ox:fix": "oxlint . --fix",
        "start": "next start",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "typecheck:next": "next typegen"
    },
    "dependencies": {
        "@t3-oss/env-nextjs": "^0.13.11",
        "next": "^16.3.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@krudi/typescript-config": "^0.1.9",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "autoprefixer": "^10.5.4",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "postcss": "^8.5.25",
        "postcss-import": "^16.1.1",
        "postcss-load-config": "^6.0.1",
        "postcss-nesting": "^14.0.1",
        "typescript": "^7.0.2"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">= 24.19.0",
        "npm": ">= 12.0.0"
    }
}
