{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "react-template",
    "version": "0.1.0",
    "private": true,
    "description": "A template with Next.js built on React with focus on performance and best practices.",
    "keywords": [
        "template"
    ],
    "homepage": "https://github.com/krudi/react-template#readme",
    "bugs": {
        "url": "https://github.com/krudi/react-template/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/krudi/react-template.git"
    },
    "license": "MIT",
    "author": {
        "name": "krudi",
        "email": "patryk.kudlik@gmail.com",
        "url": "https://krudi.io"
    },
    "type": "module",
    "scripts": {
        "auth:generate": "auth generate --config src/lib/auth/auth.ts --adapter drizzle --dialect postgresql --output src/lib/db/schemas/auth.ts",
        "auth:info": "auth info --config src/lib/auth/auth.ts",
        "auth:secret": "auth secret",
        "build": "next build",
        "clean": "rm -rf .cache node_modules .next",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:seed": "node --env-file=.env --import tsx ./src/lib/db/seeders/index.ts",
        "dev": "next dev",
        "dev:turbo": "next dev --turbo",
        "format:ox": "oxfmt .",
        "format:ox:check": "oxfmt --check .",
        "lint": "npm run lint:ox && npm run format:ox:check",
        "lint:ox": "oxlint .",
        "lint:ox:fix": "oxlint . --fix",
        "start": "next start",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "typecheck:next": "next typegen"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@t3-oss/env-nextjs": "^0.13.11",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/react-form": "^1.33.5",
        "better-auth": "^1.7.5",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.3.0",
        "drizzle-orm": "^0.45.2",
        "input-otp": "^1.5.0",
        "lucide-react": "^1.46.0",
        "next": "^16.3.5",
        "next-themes": "^0.4.6",
        "nodemailer": "^10.0.10",
        "postgres": "^3.4.9",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-qr-code": "^2.2.0",
        "shadcn": "^4.21.0",
        "sonner": "^2.0.8",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "auth": "^1.7.5",
        "drizzle-kit": "^0.31.10",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "postcss": "^8.5.25",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "nanoid": "^3.3.18"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">= 24.19.0",
        "npm": ">= 12.0.0"
    }
}
