# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google
GOOGLE_SITE_VERIFICATION=""

# Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
BETTER_AUTH_TRUSTED_ORIGINS=""

# Drizzle
DATABASE_URL="postgres://react_template_local:postgres@localhost:5435/react_template_local_db"

# Docker Compose
COMPOSE_PROJECT_NAME="react-template"
COMPOSE_REMOVE_ORPHANS=1
COMPOSE_PARALLEL_LIMIT=4
COMPOSE_PROGRESS="plain"
COMPOSE_MENU=0

# PostgreSQL
POSTGRES_VERSION="16"
POSTGRES_USER="react_template_local"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="react_template_local_db"
POSTGRES_PORT=5435

# SMTP
SMTP_HOST="localhost"
SMTP_PORT="1026"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@react-template.test"

# Mailpit
MAILPIT_VERSION="v1.30.6"
MAILPIT_BIND="127.0.0.1"
MAILPIT_SMTP_PORT=1026
MAILPIT_WEB_PORT=8025
